# Copy this file to `.env` and fill in values. `.env` is gitignored.

# PokéAPI base URL (optional override; defaults to the public API).
NUXT_POKE_API_BASE_URL=https://pokeapi.co/api/v2

# Database connection string for Prisma (SQLite; resolves to prisma/dev.db).
DATABASE_URL="file:./dev.db"

# Session sealing secret for nuxt-auth-utils. Must be at least 32 characters.
# Generate one with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=
