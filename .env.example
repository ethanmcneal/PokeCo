# Copy this file to `.env` and fill in values. `.env` is gitignored.

# PokéAPI base URL (optional override; defaults to the public API).
NUXT_POKE_API_BASE_URL=https://pokeapi.co/api/v2

# --- Added in later phases (kept here to document the full surface) ---

# Database connection string for Prisma (Phase 1).
# DATABASE_URL="file:./dev.db"

# Session secret for nuxt-auth-utils (Phase 4). Must be at least 32 characters.
# NUXT_SESSION_PASSWORD=
